# Copy to `.env` and fill in. `just` (set dotenv-load) and `docker compose`
# both read `.env` automatically. Never commit the real `.env`.

# ── Web API: server ──────────────────────────────────────────────────────
# development | production (default: production). Development relaxes auth
# checks and enables extra debug routes — never use it on a reachable host.
# Note: `just` loads this file into every recipe, including the test runs.
ENVIRONMENT=production

# Bind address and port for `mra-api`. Defaults to loopback; the Docker image
# sets API_HOST=0.0.0.0 inside the container. With docker compose, API_PORT is
# the *host* port published on 127.0.0.1 (the container always listens on 8000).
API_HOST=127.0.0.1
API_PORT=8000

# Serve the OpenAPI docs (/docs, /redoc). Empty = only in development.
ENABLE_DOCS=

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Web API: authentication ──────────────────────────────────────────────
# REQUIRED. HS256 signing key for JWTs; must be at least 32 characters outside
# development. The server refuses to start without it, and docker compose
# refuses to start the stack if it is unset. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Lifetime of issued tokens, in hours
JWT_EXPIRATION_HOURS=24

# Comma-separated API keys accepted in the `X-API-Key` request header.
# Empty = API-key auth disabled.
API_KEYS=

# ── Web API: HTTP policy ─────────────────────────────────────────────────
# Comma-separated allowed CORS origins, e.g. https://app.example.com
# Empty (default) = no cross-origin browser access.
CORS_ORIGINS=

# Requests per minute per client IP, for every HTTP route except /health,
# /ready and /api/v1/health. Kept in memory: each worker process counts separately.
RATE_LIMIT_PER_MINUTE=60

# ── Web API: advanced (optional; defaults shown) ─────────────────────────
# docker compose forwards API_WORKERS, API_TIMEOUT, API_MAX_CONCURRENT_ANALYSES,
# WS_MAX_CONNECTIONS, WS_MAX_CONNECTIONS_PER_IP, CORS_METHODS and CORS_HEADERS;
# API_RELOAD and DEBUG are development-only and are not passed into the container.
# Worker processes for `mra-api` (>1 requires a fixed JWT_SECRET)
# API_WORKERS=1
# Auto-reload on code changes (`mra-api --dev` turns it on)
# API_RELOAD=false
# Seconds an analysis may run before the request gets 504
# API_TIMEOUT=300
# Analyses running at once per worker process (HTTP + WebSocket); excess get 503
# API_MAX_CONCURRENT_ANALYSES=4
# WebSocket connection caps (total, and per client IP) per worker process
# WS_MAX_CONNECTIONS=100
# WS_MAX_CONNECTIONS_PER_IP=5
# Only reported by /debug/config (`mra-api --dev` sets it to true)
# DEBUG=false
# CORS_METHODS=GET,POST,OPTIONS
# CORS_HEADERS=Authorization,Content-Type,X-API-Key

# ── Regime history (CLI and web API) ─────────────────────────────────────
# SQLite database for recorded regime analyses (`mra current-analysis --record`,
# `mra history`, GET /api/v1/regimes/{symbol}/history). Default: ~/.mra/regimes.db
# (the parent dir is created with mode 0700). docker compose sets it to a path
# on the app-data volume.
# MRA_DB_PATH=

# ── CLI ──────────────────────────────────────────────────────────────────
# Default data provider for the `mra` CLI:
#   yfinance (free, no key) | alphavantage | polygon | alpaca | tiingo
DEFAULT_PROVIDER=yfinance

# ── Data provider credentials (CLI and web API) ──────────────────────────
# Alpha Vantage — free tier: 25 requests/day
# Get a key at https://www.alphavantage.co/support/#api-key
# (ALPHAVANTAGE_API_KEY is also accepted)
ALPHA_VANTAGE_API_KEY=
# Set to 1 with a premium key for full, split/dividend-adjusted daily history
# ALPHA_VANTAGE_PREMIUM=

# Polygon.io — https://polygon.io/dashboard/signup
POLYGON_API_KEY=

# Alpaca — free Basic plan (IEX feed); needs both the key ID and secret
# Get keys at https://app.alpaca.markets (Paper or Live account → API Keys)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Data feed: iex (free, default) | sip (consolidated; free plan = 15-min delayed)
ALPACA_DATA_FEED=

# Tiingo — free tier: 50 req/hour, 1000 req/day
# Get a key at https://www.tiingo.com/account/api/token
TIINGO_API_KEY=
